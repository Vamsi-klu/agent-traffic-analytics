{
  "note": "Storage parameters (S2.2): replay chunks, compression, night recompression, CSS de-duplication. Times in ms unless the key says otherwise.",
  "replay_dir": "replays",
  "backup_dir": "backups",
  "streams": ["rrweb", "raw", "env"],
  "replay_streams": ["rrweb"],
  "chunk_ms": 10000,
  "seal_lag_ms": 10000,
  "seal_idle_ms": 30000,
  "codec": "zstd",
  "fallback_codec": "zlib",
  "levels": {"zstd": {"live": 3, "archive": 19}, "zlib": {"live": 6, "archive": 9}},
  "read_block_bytes": 1048576,
  "read_snapshot_tries": 3,
  "css_dedup": true,
  "css_dedup_streams": ["rrweb"],
  "css_min_length": 512,
  "css_hash_chars": 32,
  "recompress_after_days": 14,
  "recompress_night_hours": [1, 6],
  "recompress_max_load_per_cpu": 0.5,
  "recompress_quiet_ms": 900000,
  "recompress_sessions_per_run": 50,
  "recompress_require_ac_power": true,
  "power_probe_timeout_ms": 5000,
  "compact_min_dead_share": 0.5,
  "maintenance_tick_ms": 30000,
  "maintenance_recompress_every_ms": 600000,
  "backup_free_space_factor": 1.1,
  "migrate_batch_rows": 2000
}
