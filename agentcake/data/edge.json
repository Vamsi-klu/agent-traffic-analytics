{
  "about": "The server-half token: its format, which page requests get one, and what it holds. cake uses these values to read the tokens sites send. They are the Node middleware's values (edge/node/defaults.json, edge/node/headers.json): tests/test_edge_vectors.py checks that the two agree, and tests/vectors/edge_token.json pins the tokens both make.",
  "token_prefix": "c1",
  "payload_version": 1,
  "entry_name": "cake",
  "token_id_bytes": 12,
  "page_method": "GET",
  "page_dest": "document",
  "page_type": "text/html",
  "markdown_type": "text/markdown",
  "verdict_types": ["agent", "human"],
  "verdict_id_max": 80,
  "verdict_reasons_max": 20,
  "version_max": 40,
  "max_header_names": 40,
  "cut": {
    "path": 200,
    "sec_fetch": 20,
    "sec_fetch_user": 4,
    "sec_purpose": 40,
    "accept_language": 40,
    "sec_ch_ua": 160,
    "sec_ch_ua_platform": 30,
    "sec_ch_ua_mobile": 4,
    "user_agent": 256,
    "signature_agent": 200,
    "header_name": 64
  },
  "skip_extensions": [
    ".ico", ".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".bmp", ".tiff", ".avif", ".heic", ".heif",
    ".css", ".js", ".mjs", ".ts", ".jsx", ".tsx", ".map", ".wasm",
    ".woff", ".woff2", ".ttf", ".otf", ".eot",
    ".mp3", ".mp4", ".webm", ".wav", ".ogg", ".aac", ".m4a", ".flac", ".mov", ".avi", ".flv", ".m4v",
    ".webmanifest", ".pdf", ".zip", ".gz"
  ],
  "headers": {
    "sec_fetch_site": "sec-fetch-site",
    "sec_fetch_mode": "sec-fetch-mode",
    "sec_fetch_dest": "sec-fetch-dest",
    "sec_fetch_user": "sec-fetch-user",
    "sec_purpose": "sec-purpose",
    "accept": "accept",
    "accept_language": "accept-language",
    "sec_ch_ua": "sec-ch-ua",
    "sec_ch_ua_platform": "sec-ch-ua-platform",
    "sec_ch_ua_mobile": "sec-ch-ua-mobile",
    "user_agent": "user-agent",
    "signature_agent": "signature-agent",
    "signature": "signature",
    "signature_input": "signature-input",
    "server_timing": "server-timing"
  }
}
