{
  "about": "The browser, operating system and device type of a session, read from its User-Agent (and, for an Android browser whose User-Agent names no device, the platform its client hints give, its touch points and its screen), as PostHog names them in its web analytics ($browser, $os, $device_type). Transcribed from posthog-js packages/core/src/utils/user-agent-utils.ts (detectBrowser, detectOS, detectDevice, detectDeviceType) at commit ab4d5198a585b9da5ad71a069ab389f08a436d3f, MIT licence (THIRD_PARTY.md); web_device.py applies them. Each list is tried in order and the first rule that matches names the value: a rule matches when its pattern (Python re; (?i) makes it ignore case) is found in the User-Agent, or the vendor its or_vendor names is navigator.vendor's, and its unless pattern is not found; its then rules, tried in order, may name the value instead of its own name. Left out: browser versions and OS versions (the tables group by name only), and PostHog's opt-in hints (navigator.brave, the Google Search App), which cake.js does not record.",
  "browsers": [
    {"match": " OPR/", "then": [{"match": "Mini", "name": "Opera Mini"}], "name": "Opera"},
    {"match": "(?i)BlackBerry|PlayBook|BB10", "name": "BlackBerry"},
    {"match": "IEMobile|WPDesktop", "name": "Internet Explorer Mobile"},
    {"match": "OculusBrowser", "name": "Oculus Browser"},
    {"match": "SamsungBrowser", "name": "Samsung Internet"},
    {"match": "Edge|Edg/", "name": "Microsoft Edge"},
    {"match": "Vivaldi/", "name": "Vivaldi"},
    {"match": "YaBrowser/", "name": "Yandex"},
    {"match": "Whale/", "name": "Whale"},
    {"match": "DuckDuckGo/|Ddg/", "name": "DuckDuckGo"},
    {"match": "Claude/", "name": "Claude"},
    {"match": "Codex/", "name": "Codex"},
    {"match": "ChatGPT/", "name": "ChatGPT"},
    {"match": "FBIOS", "name": "Facebook Mobile"},
    {"match": "UCWEB|UCBrowser", "name": "UC Browser"},
    {"match": "CriOS", "name": "Chrome iOS"},
    {"match": "CrMo|Chrome", "name": "Chrome"},
    {"match": "Android.*Safari|Safari.*Android", "name": "Android Mobile"},
    {"match": "FxiOS", "name": "Firefox iOS"},
    {"match": "(?i)konqueror", "name": "Konqueror"},
    {"match": "Brave/", "name": "Brave"},
    {"match": "Safari", "unless": "Chrome|Android", "or_vendor": "Apple", "then": [{"match": "Mobile", "name": "Mobile Safari"}],
     "name": "Safari"},
    {"match": "PaleMoon/", "name": "Pale Moon"},
    {"match": "Waterfox/", "name": "Waterfox"},
    {"match": "Firefox", "name": "Firefox"},
    {"match": "MSIE|Trident/", "name": "Internet Explorer"},
    {"match": "Gecko", "name": "Firefox"}
  ],
  "systems": [
    {"match": "(?i)Xbox; Xbox (.*?)[);]", "name": "Xbox"},
    {"match": "(?i)Nintendo", "name": "Nintendo"},
    {"match": "(?i)PlayStation", "name": "PlayStation"},
    {"match": "(?i)BlackBerry|PlayBook|BB10", "name": "BlackBerry"},
    {"match": "(?i)Windows", "then": [{"match": "Phone|WPDesktop", "name": "Windows Phone"},
                                      {"match": "Mobile", "unless": "IEMobile\\b", "name": "Windows Mobile"}],
     "name": "Windows"},
    {"match": "(iPhone|iPad|iPod).*?OS (\\d+)_(\\d+)_?(\\d+)?|iPhone", "name": "iOS"},
    {"match": "(?i)watch.*/(\\d+\\.\\d+\\.\\d+)|watch os,(\\d+\\.\\d+),", "name": "watchOS"},
    {"match": "(?i)Android", "name": "Android"},
    {"match": "(?i)Mac", "name": "Mac OS X"},
    {"match": "CrOS", "name": "Chrome OS"},
    {"match": "(?i)Linux|debian", "name": "Linux"}
  ],
  "devices": [
    {"match": "(?i)Nintendo \\w+", "name": "Nintendo"},
    {"match": "(?i)PlayStation \\w+", "name": "PlayStation"},
    {"match": "(?i)Xbox", "name": "Xbox"},
    {"match": "(?i)Ouya", "name": "Ouya"},
    {"match": "(?i)(Windows Phone|WPDesktop)", "name": "Windows Phone"},
    {"match": "iPad", "name": "iPad"},
    {"match": "iPod", "name": "iPod Touch"},
    {"match": "iPhone", "name": "iPhone"},
    {"match": "(?i)(watch)(?: ?os[,/]|\\d,\\d/)[\\d.]+", "name": "Apple Watch"},
    {"match": "(?i)BlackBerry|PlayBook|BB10", "name": "BlackBerry"},
    {"match": "(?i)(kobo)\\s(ereader|touch)", "name": "Kobo"},
    {"match": "(?i)Nokia", "name": "Nokia"},
    {"match": "(?i)(kf[a-z]{2}wi|aeo[c-r]{2})( bui|\\))|(kf[a-z]+)( bui|\\)).+silk/", "name": "Kindle Fire"},
    {"match": "(?i)(Android|ZTE)", "then": [
      {"match": "Mobile", "unless": "(?i)(9138B|TB782B|Nexus [97]|pixel c|HUAWEISHT|BTV|noble nook|smart ultra 6)", "name": "Android"},
      {"match": "(?i)pixel[\\daxl ]{1,6}", "unless": "(?i)pixel c", "name": "Android"},
      {"match": "(?i)(huaweimed-al00|tah-|APA|SM-G92|i980|zte|U304AA)", "name": "Android"},
      {"match": "(?i)lmy47v", "unless": "(?i)QTAQZ3", "name": "Android"}
    ], "name": "Android Tablet"},
    {"match": "(?i)(pda|Mobile)", "name": "Generic mobile"},
    {"match": "(?i)Tablet", "unless": "(?i)Tablet pc", "name": "Generic tablet"}
  ],
  "device_types": {
    "Tablet": ["iPad", "Android Tablet", "Kobo", "Kindle Fire", "Generic tablet"],
    "Console": ["Nintendo", "Xbox", "PlayStation", "Ouya"],
    "Wearable": ["Apple Watch"]
  },
  "any_device_type": "Mobile",
  "no_device_type": "Desktop",
  "android_platform": "Android",
  "tablet_short_side_dp": 600,
  "tablet_type": "Tablet"
}
