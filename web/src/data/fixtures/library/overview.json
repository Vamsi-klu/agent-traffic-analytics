    "rows": [
      {
        "what": "A human",
        "verdict": "human",
        "shown_as": "The comparison group",
        "how": "There are no automation traces and no agent name, and the behavior model judges the actions to be human."
      },
      {
        "what": "A browser extension, an AI browser, or a cloud agent, like Claude in Chrome, Comet, or ChatGPT agent",
        "verdict": "agent",
        "shown_as": "Agent, named when the evidence identifies it",
        "how": "There are agent traces in the page or the browser, and the behavior model judges the actions to be an agent's. Traces include an extension acting on the page or a cloud computer's fixed setup. The name comes from a verified signature, the product's own traces, or the User-Agent."
      },
      {
        "what": "The built-in browser of an AI desktop app, or a cloud agent that gives its name",
        "verdict": "agent",
        "shown_as": "Agent, identified by name, such as Codex browser",
        "how": "The User-Agent contains a name, or a verified signature names the visitor. The behavior model still splits the session into stretches."
      },
      {
        "what": "An automated browser that doesn't give its name, like Playwright, Puppeteer, or Selenium",
        "verdict": "agent",
        "shown_as": "Agent, identified by the tool's name when its traces show it, otherwise Unnamed",
        "how": "The browser shows automation markers, such as webdriver, a headless browser, or requests without a language header. The behavior model splits the session into stretches. Crawler-like patterns only go into the reasons."
      },
      {
        "what": "A program that gives its name and isn't an agent: a search engine, a monitor, a link preview",
        "verdict": "bot",
        "shown_as": "Counted only; marked “Verified” when its signature is valid",
        "how": "The User-Agent or a signature matches the list of programs that aren't agents. It's marked “Verified” when a published address range or a signature confirms it. The behavior model doesn't run."
      },
      {
        "what": "A human and an agent taking turns",
        "verdict": "agent",
        "shown_as": "Human + agent, split at each hand-off",
        "how": "The behavior model finds both a human and an agent in the same session and marks the hand-off where the actions change."
      },
      {
        "what": "Too few actions, or a phone or tablet",
        "verdict": "human",
        "shown_as": "Human, marked Thin evidence, with the reason",
        "how": "There are fewer actions than the behavior model needs, or the visit comes from a phone or tablet, so no guess is made. A setting controls how many actions the model needs."
      },
      {
        "what": "Evidence that's too weak or points both ways",
        "verdict": "human",
        "shown_as": "Human, marked Thin evidence, with the reason",
        "how": "The evidence is too weak or points both ways. Examples include a trace that open DevTools also leave and keyboard navigation like an assistive tool's."
      }
    ],
    "bot": {
      "question": "What counts as a bot",
      "answer": "A bot is a program that names itself and is known to have no human behind it, such as a search engine, a monitor, or a link preview. A visitor that only seems automated counts as an Agent, never a Bot."
