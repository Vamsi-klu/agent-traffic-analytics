    "title": "What AgentCake records",
    "lead": "AgentCake classifies each session on this computer, when new activity arrives and again when the session goes inactive. It doesn't call any AI service.",
    "columns": {
      "what": "Visitor",
      "shown_as": "Classification",
      "how": "Decision method"
