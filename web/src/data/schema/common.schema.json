{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shapes shared by the /api endpoints (web/src/data/types.ts)",
  "$defs": {
    "Verdict": { "enum": ["human", "agent", "bot"] },
    "Actor": { "enum": ["human", "agent", "unsure"] },
    "AgentTurns": { "enum": ["agent_only", "human_agent"] },
    "Certainty": { "enum": ["verified", "likely"] },
    "Count": { "type": "integer", "minimum": 0 },
    "Ms": { "type": "integer", "minimum": 0 },
    "Percent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "Text": { "type": "string", "minLength": 1 },
    "Share": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human", "agent", "unsure"],
      "properties": {
        "human": { "$ref": "#/$defs/Percent" },
        "agent": { "$ref": "#/$defs/Percent" },
        "unsure": { "$ref": "#/$defs/Percent" }
      }
    },
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["who", "start_ms", "end_ms"],
      "properties": {
        "who": { "$ref": "#/$defs/Actor" },
        "start_ms": { "$ref": "#/$defs/Ms" },
        "end_ms": { "$ref": "#/$defs/Ms" }
      }
    },
    "Handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at_ms", "to"],
      "properties": {
        "at_ms": { "$ref": "#/$defs/Ms" },
        "to": { "enum": ["human", "agent"] }
      }
    },
    "Timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "segments", "handoffs"],
      "properties": {
        "duration_ms": { "$ref": "#/$defs/Ms" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/Segment" } },
        "handoffs": { "type": "array", "items": { "$ref": "#/$defs/Handoff" } }
      }
    },
    "SessionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "verdict", "evidence", "agent_turns", "agent", "certainty", "when", "duration_ms", "pages", "share"],
      "properties": {
        "id": { "$ref": "#/$defs/Text" },
        "verdict": { "$ref": "#/$defs/Verdict" },
        "evidence": { "enum": ["thin", null] },
        "agent_turns": { "enum": ["agent_only", "human_agent", null] },
        "agent": { "type": ["string", "null"], "minLength": 1 },
        "certainty": { "enum": ["verified", "likely", null] },
        "when": { "$ref": "#/$defs/Text" },
        "duration_ms": { "$ref": "#/$defs/Ms" },
        "pages": { "$ref": "#/$defs/Count" },
        "share": { "$ref": "#/$defs/Share" },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Segment" } },
        "demo_shop": { "description": "Set only on a session an earlier AgentCake's demo shop recorded, not the website.", "const": true },
        "tabs": { "description": "Set only on a session of more than one tab session: each tab, Tab 1 first.", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/TabTrack" } },
        "agents": { "description": "Set only when its tabs name more than one agent, named ones first.", "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/AgentName" } }
      }
    },
    "TabTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "segments"],
      "properties": {
        "start_ms": { "$ref": "#/$defs/Ms" },
        "end_ms": { "$ref": "#/$defs/Ms" },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/Segment" } }
      }
    },
    "AgentName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "certainty"],
      "properties": {
        "name": { "type": ["string", "null"], "minLength": 1 },
        "certainty": { "enum": ["verified", "likely", null] }
      }
    },
    "SessionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "human", "agent", "bot", "agent_only", "human_agent", "thin"],
      "properties": {
        "all": { "$ref": "#/$defs/Count" },
        "human": { "$ref": "#/$defs/Count" },
        "agent": { "$ref": "#/$defs/Count" },
        "bot": { "$ref": "#/$defs/Count" },
        "agent_only": { "$ref": "#/$defs/Count" },
        "human_agent": { "$ref": "#/$defs/Count" },
        "thin": { "$ref": "#/$defs/Count" }
      }
    },
    "NullableText": { "type": ["string", "null"], "minLength": 1 },
    "Disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "free", "min_free", "low"],
      "properties": {
        "total": { "$ref": "#/$defs/Count" },
        "free": { "$ref": "#/$defs/Count" },
        "min_free": { "$ref": "#/$defs/Count" },
        "low": { "type": "boolean" }
      }
    },
    "ReplaysStopped": { "enum": ["disk", "budget", null] },
    "AddressCheck": {
      "description": "On a server, whether the visitor's address AgentCake reads is a CDN's own (agentcake/address_check.py): of the latest sessions with an address (at most data/verdict.json address_check.sessions), how many came from a CDN's published IP ranges; misconfigured when that is enough of them, and then sessions are judged as if they had no address. All zero and false where no address is read (this computer, or trust_lb off).",
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions", "cdn", "misconfigured"],
      "properties": {
        "sessions": { "$ref": "#/$defs/Count" },
        "cdn": { "$ref": "#/$defs/Count" },
        "misconfigured": { "type": "boolean" }
      }
    },
    "Attribution": {
      "description": "The credit a data source asks for on every page that shows its results (DB-IP's link, \"IP Geolocation by DB-IP\"); null while none of its results is shown.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["text", "url"],
      "properties": { "text": { "$ref": "#/$defs/Text" }, "url": { "$ref": "#/$defs/Text" } }
    },
    "PlaceSource": {
      "description": "Where visitors' country, region and city come from: none (AgentCake on this computer sees no visitor addresses), missing (a server whose city database is not downloaded yet) or database (DB-IP's IP to City Lite).",
      "enum": ["none", "missing", "database"]
    },
    "Places": {
      "description": "The source of places, and the credit every page that shows places carries while the database is in use.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "attribution"],
      "properties": {
        "source": { "$ref": "#/$defs/PlaceSource" },
        "attribution": { "$ref": "#/$defs/Attribution" }
      }
    }
  }
}
