{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "settings.schema.json",
  "title": "Settings",
  "description": "GET /api/settings, and the answer to POST /api/settings : everything the settings page shows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["site_domain", "site_key", "script_tag", "sources", "last_seen", "route", "server_half", "refresh_ms", "lists", "lists_auto_update", "retention_days", "retention_choices", "budget_mb", "budget_choices_mb", "auto_free", "storage", "hook_dom", "hide_selectors", "timezone", "timezone_machine", "database"],
  "properties": {
    "site_domain": { "type": "string" },
    "site_key": { "type": ["string", "null"], "minLength": 1 },
    "script_tag": { "$ref": "common.schema.json#/$defs/Text" },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "server_half"],
      "properties": {
        "site": { "$ref": "#/$defs/Connection" },
        "server_half": { "$ref": "#/$defs/Connection" }
      }
    },
    "last_seen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "server_half"],
      "properties": {
        "site": { "type": ["string", "null"], "minLength": 1 },
        "server_half": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "route": { "enum": ["this_computer", "server"] },
    "server_half": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing", "logs"],
      "properties": {
        "missing": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Text" } },
        "logs": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["last", "format", "missing", "empty"],
          "properties": {
            "last": { "$ref": "common.schema.json#/$defs/Text" },
            "format": { "$ref": "common.schema.json#/$defs/Text" },
            "missing": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Text" } },
            "empty": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/Text" } }
          }
        }
      }
    },
    "refresh_ms": { "type": "integer", "minimum": 1 },
    "lists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["built", "age_days", "max_age_days", "stale", "update_command", "last_update", "failures", "failing", "city_database"],
      "properties": {
        "built": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "age_days": { "type": "integer" },
        "max_age_days": { "$ref": "common.schema.json#/$defs/Count" },
        "stale": { "type": "boolean" },
        "update_command": { "$ref": "common.schema.json#/$defs/Text" },
        "last_update": {
          "description": "The last update of the lists (and on a server the city database), monthly or by the command: when it ran, in the server's words; whether it succeeded; the error when it didn't. null before the first.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["when", "ok", "error"],
          "properties": {
            "when": { "$ref": "common.schema.json#/$defs/Text" },
            "ok": { "type": "boolean" },
            "error": { "type": ["string", "null"] }
          }
        },
        "failures": { "description": "Failed updates in a row.", "$ref": "common.schema.json#/$defs/Count" },
        "failing": { "description": "Enough failed updates in a row to warn.", "type": "boolean" },
        "city_database": { "description": "Whether the update takes in the city database too: only on a server that reads the visitor's address (public_listen and trust_lb).", "type": "boolean" }
      }
    },
    "lists_auto_update": { "description": "Whether AgentCake updates the lists, and on a server the city database, once a month.", "type": "boolean" },
    "retention_days": { "$ref": "common.schema.json#/$defs/Count" },
    "retention_choices": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/Count" } },
    "budget_mb": { "type": "integer", "minimum": 1 },
    "budget_choices_mb": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
    "auto_free": { "type": "boolean" },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used_bytes", "warn_at_pct", "days_left", "disk", "replays_stopped", "free_to_pct"],
      "properties": {
        "used_bytes": { "$ref": "common.schema.json#/$defs/Count" },
        "warn_at_pct": { "$ref": "common.schema.json#/$defs/Percent" },
        "days_left": { "type": ["number", "null"], "minimum": 0 },
        "disk": { "$ref": "common.schema.json#/$defs/Disk" },
        "replays_stopped": { "$ref": "common.schema.json#/$defs/ReplaysStopped" },
        "free_to_pct": { "$ref": "common.schema.json#/$defs/Percent" }
      }
    },
    "hook_dom": { "type": "boolean" },
    "hide_selectors": { "type": "string" },
    "timezone": { "description": "The IANA time zone days and times are written in; empty to follow this computer's.", "type": "string" },
    "timezone_machine": {
      "description": "This computer's time zone: its IANA name (null when nothing names one) and what the pages call it now (PST, UTC, UTC+05:45).",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "short"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/NullableText" },
        "short": { "$ref": "common.schema.json#/$defs/Text" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sessions"],
      "properties": {
        "path": { "$ref": "common.schema.json#/$defs/Text" },
        "sessions": { "$ref": "common.schema.json#/$defs/Count" }
      }
    }
  },
  "$defs": {
    "Connection": { "enum": ["receiving", "waiting", "not_connected"] }
  }
}
