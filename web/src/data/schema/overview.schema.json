{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overview.schema.json",
  "title": "Overview",
  "description": "GET /api/overview?range= : the dashboard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["counts", "agent_earlier", "agents_seen", "page_views", "pages_per_session", "latest_agent", "storage", "coverage", "address_check"],
  "properties": {
    "counts": { "$ref": "common.schema.json#/$defs/SessionCounts" },
    "agent_earlier": { "description": "Agent sessions of the range's previous period, PostHog's: as long as the range runs to the end of its current hour or day, right before it (25 hours, 8 days, 31 days); null for all time, which has no earlier range.", "type": ["integer", "null"], "minimum": 0 },
    "agents_seen": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sessions"],
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/NullableText" },
          "sessions": { "$ref": "common.schema.json#/$defs/Count" }
        }
      }
    },
    "page_views": {
      "description": "How many times a page opened in the range's sessions: all of them, and by the session's verdict (they add up to all).",
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "human", "agent", "bot"],
      "properties": {
        "all": { "$ref": "common.schema.json#/$defs/Count" },
        "human": { "$ref": "common.schema.json#/$defs/Count" },
        "agent": { "$ref": "common.schema.json#/$defs/Count" },
        "bot": { "$ref": "common.schema.json#/$defs/Count" }
      }
    },
    "pages_per_session": { "$ref": "#/$defs/PagesPerSession" },
    "latest_agent": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/SessionSummary" } },
    "storage": { "$ref": "#/$defs/Storage" },
    "coverage": { "$ref": "#/$defs/Coverage" },
    "address_check": { "$ref": "common.schema.json#/$defs/AddressCheck" }
  },
  "$defs": {
    "Pages": { "type": ["number", "null"], "minimum": 0 },
    "PagesPerSession": {
      "description": "Page views divided by sessions: of all sessions and of each verdict's; null when the range has no such session.",
      "type": "object",
      "additionalProperties": false,
      "required": ["all", "human", "agent", "bot"],
      "properties": {
        "all": { "$ref": "#/$defs/Pages" },
        "human": { "$ref": "#/$defs/Pages" },
        "agent": { "$ref": "#/$defs/Pages" },
        "bot": { "$ref": "#/$defs/Pages" }
      }
    },
    "Storage": {
      "description": "The disk budget and what cake's data uses of it, whatever the filters: the settings page's numbers (storage, budget_mb, auto_free), with the disk under it and why new replays are stopped, if they are.",
      "type": "object",
      "additionalProperties": false,
      "required": ["used_bytes", "budget_mb", "warn_at_pct", "days_left", "auto_free", "free_to_pct", "disk", "replays_stopped"],
      "properties": {
        "used_bytes": { "$ref": "common.schema.json#/$defs/Count" },
        "budget_mb": { "type": "integer", "minimum": 1 },
        "warn_at_pct": { "$ref": "common.schema.json#/$defs/Percent" },
        "days_left": { "type": ["number", "null"], "minimum": 0 },
        "auto_free": { "type": "boolean" },
        "free_to_pct": { "$ref": "common.schema.json#/$defs/Percent" },
        "disk": { "$ref": "common.schema.json#/$defs/Disk" },
        "replays_stopped": { "$ref": "common.schema.json#/$defs/ReplaysStopped" }
      }
    },
    "Coverage": {
      "description": "What counts as a bot: the Bot number's \"?\".",
      "type": "object",
      "additionalProperties": false,
      "required": ["bot"],
      "properties": {
        "bot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question", "answer"],
          "properties": {
            "question": { "$ref": "common.schema.json#/$defs/Text" },
            "answer": { "$ref": "common.schema.json#/$defs/Text" }
          }
        }
      }
    }
  }
}
