{
  "name": "cake-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "cake's local dashboard: shadcn/ui components + the Frosting theme. Built to static files (dist/) that cake ships; users do not need Node.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5179",
    "build": "tsc -b && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5179",
    "check:ui": "node scripts/check-ui.mjs && node scripts/check-schemas.mjs",
    "test": "node --test \"scripts/*.test.mjs\" \"tests/*.test.mjs\"",
    "shots": "node scripts/shots.mjs",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.62.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
